# Puerto donde escuchará el servidor Fastify
PORT=3000

# Origen permitido para CORS (o '*' si se usa sin proxy)
CORS_ORIGIN=http://localhost:5173

# Modo por defecto: 'live' (SOAP real) o 'mock' (archivo local response.xml)
DEFAULT_MODE=mock

# Configuración del servicio SOAP (VPN / Servidor interno)
SOAP_URL=http://192.168.168.247:8088/ProductosWebSOAP/ProductosWeb.asmx
SOAP_ACTION=urn:editec:productosweb:v1/ConsultarProductosWeb
SOAP_NAMESPACE=urn:editec:productosweb:v1
SOAP_OPERATION=ConsultarProductosWeb
