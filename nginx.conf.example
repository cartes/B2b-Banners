# Ejemplo de configuración para Nginx en tu servidor VPN
# Guarda este bloque en /etc/nginx/sites-available/b2b-banners y crea el symlink a sites-enabled

server {
    listen 80;
    server_name _; # O coloca la IP del servidor VPN o dominio interno

    # Directorio donde se sube el contenido de frontend/dist/
    root /var/www/b2b-banners/frontend/dist;
    index index.html;

    # Soporte para Vue Router (HTML5 History Mode)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy inverso para las peticiones API hacia Fastify (puerto 3000)
    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
